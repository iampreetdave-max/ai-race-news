# Frontend environment variables (Next.js)
# Copy to .env.local for local development, or set in your host's
# build environment (Netlify / Cloudflare Pages) for production.

# Base URL of the AI Pulse API.
# - Leave EMPTY (the default) to run in static mode: the frontend reads
#   pre-built JSON from /data/*.json that the scraper commits to the repo.
# - Set to a live API origin (no trailing slash) to fetch from the API
#   instead, e.g. NEXT_PUBLIC_API_URL=https://api.airace.news
# Must be prefixed with NEXT_PUBLIC_ to be exposed to the browser bundle.
NEXT_PUBLIC_API_URL=
